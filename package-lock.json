// Packs project_id / country / age_band into an opaque, URL-safe token so
// tracking links handed to clients never expose those values directly.
// This is obfuscation, not encryption — anyone who decodes the base64 can
// read the values back out — but it keeps them out of the plain query
// string, which is what client-facing links need.
//
// Mirrors the encode logic in src/lib/trackToken.js. Keep both in sync.

export function decodeTrackToken(token) {
  try {
    let b64 = String(token).replace(/-/g, '+').replace(/_/g, '/')
    while (b64.length % 4) b64 += '='
    const payload = Buffer.from(b64, 'base64').toString('utf-8')
    const parsed = JSON.parse(payload)
    if (!Array.isArray(parsed) || !parsed[0]) return null
    const [project_id, country, age_band] = parsed
    return {
      project_id,
      country: country || null,
      age_band: age_band || null,
    }
  } catch {
    return null
  }
}

export function encodeTrackToken(project_id, country, age_band) {
  const payload = JSON.stringify([project_id, country || '', age_band || ''])
  return Buffer.from(payload, 'utf-8').toString('base64url')
}
